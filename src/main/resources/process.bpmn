    <bpmn:endEvent id="Event_024kuye">
      <bpmn:incoming>Flow_1omuksk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0piy41b" name="Application Intializer with values" camunda:delegateExpression="${workflowService}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userDetails">
            <camunda:script scriptFormat="javascript">var userDetails = {
    id:userId,
    name:userName,
    gender:gender,
    address: address,
    phone:phoneNumber,
    age:age,
}

JSON.stringify(userDetails);</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="applicationName">
            <camunda:script scriptFormat="javascript">var appliation = dbData.applicationName;
appliation;</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="loanAmount">
            <camunda:script scriptFormat="javascript">var loan = loanAmount;
loan;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="outputWorkflow">
            <camunda:script scriptFormat="javascript">print("application running...");</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1c4msml</bpmn:incoming>
      <bpmn:outgoing>Flow_1omuksk</bpmn:outgoing>
    </bpmn:serviceTask>
