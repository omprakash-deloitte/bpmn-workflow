    <bpmn:sequenceFlow id="Flow_0wm0zus" sourceRef="Activity_16xdjfp" targetRef="Activity_0ux9mbm" />
    <bpmn:scriptTask id="Activity_16xdjfp" name="Initalize DB values" scriptFormat="javascript" camunda:resultVariable="dbData">
      <bpmn:incoming>Flow_0efmzic</bpmn:incoming>
      <bpmn:outgoing>Flow_0wm0zus</bpmn:outgoing>
      <bpmn:script>var dbData = {
    rateOfIntrest:9,
    creditScore:700,
    applicationName:"Loan approval workflow"
}

dbData;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0ux9mbm" name="Fetch user Information by userId" camunda:delegateExpression="${userInformation}">
      <bpmn:incoming>Flow_0wm0zus</bpmn:incoming>
      <bpmn:outgoing>Flow_1c4msml</bpmn:outgoing>
    </bpmn:serviceTask>
