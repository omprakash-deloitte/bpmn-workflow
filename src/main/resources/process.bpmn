    <bpmn:sequenceFlow id="Flow_0779rd6" sourceRef="Activity_0281j80" targetRef="Gateway_0xmtdt3" />
    <bpmn:businessRuleTask id="Activity_0281j80" name="Check loan eligibility status" camunda:resultVariable="loanStatus" camunda:decisionRef="loan_eligibility_dmn" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_09isocu</bpmn:incoming>
      <bpmn:outgoing>Flow_0779rd6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="Activity_14s1pnx" name="Loan approved" calledElement="email_approval_subprocess">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">${"Approved"}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hhmoad</bpmn:incoming>
      <bpmn:incoming>Flow_17b6pkw</bpmn:incoming>
      <bpmn:outgoing>Flow_18rcrr7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Activity_05diwym" name="Manual Review" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="reviewDecision" label="Review Decision" type="enum">
            <camunda:value id="APPROVE" name="APPROVE" />
            <camunda:value id="REJECT" name="REJECT" />
          </camunda:formField>
          <camunda:formField id="comments" label="Comments" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0nbd4ej</bpmn:incoming>
      <bpmn:outgoing>Flow_0ruj0pi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_13u1tjq">
      <bpmn:incoming>Flow_0sh1k1m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0sh1k1m" sourceRef="Activity_15mdmcp" targetRef="Event_13u1tjq" />
    <bpmn:serviceTask id="Activity_15mdmcp" name="Notify Manager" camunda:delegateExpression="${notifyManager}">
