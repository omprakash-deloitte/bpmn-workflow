<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0dznbmp" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="process-logger" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0efmzic</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0efmzic" sourceRef="StartEvent_1" targetRef="Activity_16xdjfp" />
    <bpmn:serviceTask id="Activity_0piy41b" name="Application Intializer with values" camunda:delegateExpression="${workflowService}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userDetails">
            <camunda:script scriptFormat="javascript">var userDetails = {
    id:userId,
    name:userName,
    gender:gender,
    address: address,
    phone:phoneNumber,
    age:age,
}

JSON.stringify(userDetails);</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="applicationName">
            <camunda:script scriptFormat="javascript">var appliation = dbData.applicationName;
appliation;</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="loanAmount">
            <camunda:script scriptFormat="javascript">var loan = loanAmount;
loan;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="outputWorkflow">
            <camunda:script scriptFormat="javascript">print("application running...");</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1c4msml</bpmn:incoming>
      <bpmn:outgoing>Flow_09isocu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1c4msml" sourceRef="Activity_0ux9mbm" targetRef="Activity_0piy41b" />
    <bpmn:sequenceFlow id="Flow_0wm0zus" sourceRef="Activity_16xdjfp" targetRef="Activity_0ux9mbm" />
    <bpmn:scriptTask id="Activity_16xdjfp" name="Initalize DB values" scriptFormat="javascript" camunda:resultVariable="dbData">
      <bpmn:incoming>Flow_0efmzic</bpmn:incoming>
      <bpmn:outgoing>Flow_0wm0zus</bpmn:outgoing>
      <bpmn:script>var dbData = {
    rateOfIntrest:9,
    creditScore:750,
    applicationName:"Loan approval workflow"
}

dbData;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0ux9mbm" name="Fetch user Information by userId" camunda:delegateExpression="${userInformation}">
      <bpmn:incoming>Flow_0wm0zus</bpmn:incoming>
      <bpmn:outgoing>Flow_1c4msml</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0xmtdt3" default="Flow_0syu9ck">
      <bpmn:incoming>Flow_0779rd6</bpmn:incoming>
      <bpmn:outgoing>Flow_1hhmoad</bpmn:outgoing>
      <bpmn:outgoing>Flow_0syu9ck</bpmn:outgoing>
      <bpmn:outgoing>Flow_0nbd4ej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1hhmoad" sourceRef="Gateway_0xmtdt3" targetRef="Activity_14s1pnx">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${loanStatus == 'Approved'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0syu9ck" sourceRef="Gateway_0xmtdt3" targetRef="Activity_172mh82" />
    <bpmn:endEvent id="Event_023kj55">
      <bpmn:incoming>Flow_08lqqp9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_08lqqp9" sourceRef="Activity_172mh82" targetRef="Event_023kj55" />
    <bpmn:endEvent id="Event_0plbx3o">
      <bpmn:incoming>Flow_1nlisis</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1nlisis" sourceRef="Activity_14s1pnx" targetRef="Event_0plbx3o" />
    <bpmn:scriptTask id="Activity_172mh82" name="Rejected" scriptFormat="javascript">
      <bpmn:incoming>Flow_0syu9ck</bpmn:incoming>
      <bpmn:outgoing>Flow_08lqqp9</bpmn:outgoing>
      <bpmn:script>print("Not eligble for loan");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0nbd4ej" sourceRef="Gateway_0xmtdt3" targetRef="Activity_05diwym">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${loanStatus == 'Manual'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0ouz8oz">
      <bpmn:incoming>Flow_1ohru54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1ohru54" sourceRef="Activity_05diwym" targetRef="Event_0ouz8oz" />
    <bpmn:sequenceFlow id="Flow_09isocu" sourceRef="Activity_0piy41b" targetRef="Activity_0281j80" />
    <bpmn:sequenceFlow id="Flow_0779rd6" sourceRef="Activity_0281j80" targetRef="Gateway_0xmtdt3" />
    <bpmn:businessRuleTask id="Activity_0281j80" name="Check loan eligibility status" camunda:resultVariable="loanStatus" camunda:decisionRef="loan_eligibility_dmn" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_09isocu</bpmn:incoming>
      <bpmn:outgoing>Flow_0779rd6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_14s1pnx" name="Send Approval Email" camunda:delegateExpression="${approvalEmail}">
      <bpmn:incoming>Flow_1hhmoad</bpmn:incoming>
      <bpmn:outgoing>Flow_1nlisis</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_05diwym" name="Manual Review">
      <bpmn:incoming>Flow_0nbd4ej</bpmn:incoming>
      <bpmn:outgoing>Flow_1ohru54</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:textAnnotation id="TextAnnotation_0gdowrt">
      <bpmn:text>Intialize applicaiton with default values</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0wyh9u1" sourceRef="Activity_0piy41b" targetRef="TextAnnotation_0gdowrt" />
    <bpmn:textAnnotation id="TextAnnotation_1n91p0f">
      <bpmn:text>Pass userId to get user details</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0tzzs7d" sourceRef="Activity_0ux9mbm" targetRef="TextAnnotation_1n91p0f" />
    <bpmn:textAnnotation id="TextAnnotation_1j03zz2">
      <bpmn:text>Intialize values which supposed to be present in DB</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0c38vxz" sourceRef="Activity_16xdjfp" targetRef="TextAnnotation_1j03zz2" />
  </bpmn:process>
